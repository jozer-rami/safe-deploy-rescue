# Copy to .env. Never commit .env.

# RPCs
GNOSIS_RPC_URL=https://rpc.gnosischain.com
POLYGON_RPC_URL=https://polygon-rpc.com
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
ETHEREUM_RPC_URL=https://ethereum.publicnode.com

# Generic extract / rescue / verify
SOURCE_RPC_URL=
TARGET_RPC_URL=
CREATION_TX_HASH=
SAFE_ADDRESS=

# Optional explorer API keys (scripts talk to RPCs today; these are for
# explorer lookups if you add them later).
# Etherscan V2 uses one key across many chains: https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
GNOSISSCAN_API_KEY=

# Any funded EOA. Pays gas only. Does not become a Safe owner.
DEPLOYER_PRIVATE_KEY=

# Deploys are dry-run unless you opt in:
# BROADCAST=1
